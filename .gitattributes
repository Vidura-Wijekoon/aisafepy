# Normalise line endings so Windows and POSIX contributors produce
# identical blobs. Text files are stored with LF in the repository.
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
Makefile text eol=lf

# Binary assets.
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.zip binary
*.pt binary
*.safetensors binary
*.duckdb binary
